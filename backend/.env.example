# Node.js API Gateway
PORT=3000
NODE_ENV=development
PYTHON_SERVICE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6380
DISABLE_REDIS=true

# Python ML Service
PYTHON_PORT=8000
MODEL_PATH=./models/oceanembed_sih_prototype.pt
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ocean_db
POSTGRES_USER=ocean_user
POSTGRES_PASSWORD=ocean_secret_pass
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ocean-data
MINIO_USE_SSL=false

# Live Data API Credentials
COPERNICUS_USER=your_copernicus_username
COPERNICUS_PASS=your_copernicus_password
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

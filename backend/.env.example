# Node.js API Gateway
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
PYTHON_SERVICE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6380
DISABLE_REDIS=true

# Authentication
JWT_SECRET=oceanembed-super-secret-jwt-key-2024
JWT_EXPIRES_IN=24h

# Firebase (for sync-password token verification)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# Python ML Service
PYTHON_PORT=8000
LOAD_MODEL=true
MODEL_PATH=./models/oceanembed_sih_prototype.pt
# PostgreSQL Database (Local Development)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ocean_db
POSTGRES_USER=ocean_user
POSTGRES_PASSWORD=ocean_secret_pass

# PostgreSQL Database (Production / Render)
# If provided, this overrides the individual POSTGRES_* variables above.
# DATABASE_URL=postgresql://ocean_user:ocean_secret_pass@localhost:5433/ocean_db
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ocean-data
MINIO_USE_SSL=false

# Live Data API Credentials
COPERNICUS_USER=your_copernicus_username
COPERNICUS_PASS=your_copernicus_password
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password
